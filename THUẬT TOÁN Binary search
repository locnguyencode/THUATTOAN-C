#include<stdio.h>
#include<math.h>
int bns(int a[],int l,int r,int x ){//trái(l) phải(r),x cần tìm
if(l<=r){
int mid=(l+r)/2;
if(a[mid]==x){//nếu mảng a [mid] mà bằng giá trị x thì trả về 1 luôn
return 1;
}
else if(a[mid]>x)//theo đúng lý thuyết thì bé hơn nhưng do đây là bài giảm dần
return bns(a,mid+1,r,x);//nếu ở giữa bé hơn giá trị cần tìm x,thì left=mid+1 giá trị bên phải(r)
else return bns(a,l,mid-1,x);//nếu ở giữa lớn hơn x thì sẽ lùi về trái để tìm giá trị x /*lớn hay nhỏ là số cần tìm trong mảng chứ ko phải là*/
/*số lớn hay bé*/
//nhớ nhé trái ,giữa,phải(l,m,r) nhớ ko sai return kìa
}
else{
return 0;
}
}
int main(){
int n;
scanf("%d",&n);
int a[n];
for(int i=0;i<n;i++){      
scanf("%d",&a[i]);
}
int x;
scanf("%d",&x);
printf("%d",bns(a,0,n-1,x));
return 0;
}
